# Copy to .env, then fill in the secrets (openssl rand -hex 32).
#
# docker-compose.yml reads .env for variable substitution. One file also has to be
# rendered, because Lemmy cannot read its settings from the environment — verified
# in crates/utils/src/settings/mod.rs at v0.19.20, which honours only
# LEMMY_CONFIG_LOCATION and LEMMY_DATABASE_URL:
#
#   set -a; . ./.env; set +a
#   mkdir -p .lemmy && envsubst < lemmy/config.hjson.template > .lemmy/config.hjson
#
# compose has the same non-secret defaults inline, so `docker compose up -d` works
# on a fresh clone with no .env at all (except the community, which needs secrets).
# On the deploy host .env is written from GitHub Actions Secrets. It is git-ignored,
# chmod 600, and blocked at the web root by nginx.conf.

# ---------- Settings ----------

# Public origin of the community. Federation identifies the instance by this
# value, so it cannot change casually. For local testing use "localhost:10633"
# together with LEMMY_UI_HTTPS=false.
LEMMY_DOMAIN=social.athensarea.net

# Host port the community is published on. Deliberately off :80/:443/:8080, which
# an unrelated reverse proxy already owns on this machine, and off :5432/:3001,
# which other stacks on this box use.
LEMMY_HTTP_PORT=10633

# Set false only when the community is reached over plain http (local testing).
LEMMY_UI_HTTPS=true

# ---------- Secrets ----------

# Postgres password for the community database.
LEMMY_DB_PASSWORD=

# Shared secret between Lemmy and pictrs, its object store.
LEMMY_PICTRS_API_KEY=

# Cloudflare Turnstile for the classifieds form. Set SITE_KEY and SECRET TOGETHER,
# never one without the other: secret without site key means the widget cannot
# render and every post is rejected; site key without secret means the widget is
# shown but never verified. Both empty disables the check entirely.

# Public site key (rendered into the widget; not secret).
TURNSTILE_SITE_KEY=

# Server-side siteverify secret key (account-owned, never committed).
TURNSTILE_SECRET=

